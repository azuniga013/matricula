<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <handlers>
      <remove name="WebDAV" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="Bloquear archivos no publicos" stopProcessing="true">
          <match url="^(?:\.env(?:\..*)?|\.git(?:/.*)?|app(?:/.*)?|artisan|bootstrap(?:/.*)?|composer\.(?:json|lock)|config(?:/.*)?|database(?:/.*)?|node_modules(?:/.*)?|package(?:-lock)?\.json|phpunit\.xml|resources(?:/.*)?|routes(?:/.*)?|storage(?:/.*)?|tests(?:/.*)?|vendor(?:/.*)?)$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>
        <rule name="Servir recursos de public" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions>
            <add input="{APPL_PHYSICAL_PATH}public\{R:1}" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="public/{R:1}" />
        </rule>
        <rule name="Laravel front controller" stopProcessing="true">
          <match url="^(.*)$" />
          <action type="Rewrite" url="public/index.php" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
